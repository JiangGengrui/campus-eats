{
  "name": "xiaowei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "校味 CAMPUS EATS · 校园外卖平台（课程设计）",
  "repository": {
    "type": "git",
    "url": "https://github.com/dickenslian/takeaway.git"
  },
  "homepage": "https://github.com/dickenslian/takeaway#readme",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "start:prod": "npm run build && npm run start",
    "seed": "npm run seed -w server",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "es-module-lexer": "^3.0.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "supertest": "^7.3.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.1.0"
  }
}
