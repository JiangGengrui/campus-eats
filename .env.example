# 服务端口
PORT=3000
# JWT 签名密钥（生产/演示环境务必修改）
JWT_SECRET=change-me-in-actual-deployment
# JWT 有效期
JWT_EXPIRES_IN=24h
# SQLite 数据库文件路径（相对 server 包根目录）
DB_PATH=./data/app.db
# 图片上传目录（相对 server 包根目录）与单图大小上限
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
# P1.2 模拟自动接单开关（on/off）与间隔秒数
AUTO_ACCEPT_ENABLED=off
AUTO_ACCEPT_INTERVAL_SECONDS=30
# 空库自举时的管理员口令（缺省 123456，公网部署务必覆盖）
ADMIN_INITIAL_PASSWORD=change-me-before-public
# 空库时是否自动灌入演示数据（on/off，库非空则跳过）
AUTO_SEED=on
